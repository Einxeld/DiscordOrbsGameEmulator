<Window x:Class="DiscordOrbsGameEmulator.AddGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DiscordOrbsGameEmulator"
        Title="Add Game / Search Online Database"
        Height="580" Width="720"
        MinHeight="480" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#1E1E2E">

    <!-- ══ WINDOW CHROME ══ -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" 
                      ResizeBorderThickness="5" 
                      GlassFrameThickness="0" 
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <!-- ══ RESOURCES ══ -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>

        <!-- Custom Title Bar Buttons -->
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8888A8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#313145"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#44445A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarCloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B80E1B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom ScrollBar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#55556A" CornerRadius="3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Buttons -->
        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.65"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#6ED89A"/>
            <Setter Property="Foreground" Value="#1E1E2E"/>
        </Style>

        <Style x:Key="DarkButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#313145"/>
            <Setter Property="Foreground" Value="#E0E0F0"/>
        </Style>

        <Style x:Key="BlueButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#7C9EF8"/>
            <Setter Property="Foreground" Value="#1E1E2E"/>
        </Style>

        <!-- Dark TextBox -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#313145"/>
            <Setter Property="Foreground" Value="#E0E0F0"/>
            <Setter Property="CaretBrush" Value="#7C9EF8"/>
            <Setter Property="BorderBrush" Value="#44445A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ══ MAIN LAYOUT GRID ══ -->
    <Grid Background="#1E1E2E">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ CUSTOM TITLE BAR ══ -->
        <Grid Grid.Row="0" Background="#181825">
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" 
                       Foreground="#8888A8" 
                       FontSize="12"
                       VerticalAlignment="Center" 
                       Margin="14,0,0,0"/>

            <!-- Window Control Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Content="🗕" Style="{StaticResource TitleBarButton}" Click="Minimize_Click"/>
                <Button Content="🗖" Style="{StaticResource TitleBarButton}" Click="Maximize_Click"/>
                <Button Content="✕" Style="{StaticResource TitleBarCloseButton}" Click="Close_Click"/>
            </StackPanel>
        </Grid>

        <!-- ══ BODY CONTENT ══ -->
        <Grid Grid.Row="1" Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Mode selector tabs -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                <RadioButton x:Name="TabOnlineRadio" Content="🌐 Search Web Database" 
                             IsChecked="True" Foreground="#E0E0F0" FontWeight="SemiBold" 
                             FontSize="14" Margin="0,0,20,0" Checked="TabRadio_Checked"/>
                <RadioButton x:Name="TabManualRadio" Content="✏️ Add Manually" 
                             Foreground="#E0E0F0" FontWeight="SemiBold" 
                             FontSize="14" Checked="TabRadio_Checked"/>
            </StackPanel>

            <!-- TAB 1: Online Search View -->
            <Grid x:Name="OnlineSearchGrid" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Search bar & fetch button -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="OnlineSearchBox"
                             Style="{StaticResource DarkTextBox}"
                             TextChanged="OnlineSearchBox_TextChanged"/>
                    <TextBlock Text="Type game name to search online DB (e.g. Overwatch, Dota 2)..."
                               Foreground="#666688" FontSize="12" IsHitTestVisible="False"
                               VerticalAlignment="Center" Margin="12,0,0,0"
                               Visibility="{Binding Text.IsEmpty, ElementName=OnlineSearchBox, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <Button Grid.Column="1" x:Name="RefreshDbButton"
                            Content="🔄 Reload Database"
                            Style="{StaticResource DarkButton}"
                            Margin="8,0,0,0"
                            Click="RefreshDbButton_Click"/>
                </Grid>

                <!-- Search Results List -->
                <Border Grid.Row="1" Background="#27273A" CornerRadius="8" BorderBrush="#44445A" BorderThickness="1">
                    <Grid>
                        <ListBox x:Name="OnlineResultsList"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="#E0E0F0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 SelectionMode="Single"
                                 SelectionChanged="OnlineResultsList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#313145" CornerRadius="6" Padding="12,8" Margin="0,3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"/>
                                                <!-- Executable Summary set to almost white (#EAEAF5) -->
                                                <TextBlock Text="{Binding ExecutableSummary}" 
                                                           FontSize="11" 
                                                           Margin="0,2,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#E0E0F0"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasExecutables}" Value="False">
                                                                    <Setter Property="Foreground" Value="#E5C890"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SteamIdDisplay}" FontSize="11" Foreground="#7C9EF8" Margin="0,0,8,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock x:Name="OnlineStatusText"
                                   Text="Type in the search box to find games from the web database."
                                   Foreground="#8888A8" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Configuration & selected details -->
                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <TextBlock x:Name="ExePathLabel" Text="Executable Path (Auto-generated or custom):" Foreground="#8888A8" FontSize="11" Margin="0,0,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="OnlineExePathBox" Style="{StaticResource DarkTextBox}"/>
                        <Button Grid.Column="1" Content="Browse..." Style="{StaticResource DarkButton}" Margin="8,0,0,0" Click="BrowseExe_Click"/>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- TAB 2: Manual Add View -->
            <Grid x:Name="ManualAddGrid" Grid.Row="1" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Top">
                    <TextBlock Text="Game Name:" Foreground="#8888A8" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="ManualNameBox" Style="{StaticResource DarkTextBox}" Margin="0,0,0,12"/>

                    <TextBlock Text="Executable Full Path (.exe):" Foreground="#8888A8" FontSize="12" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ManualPathBox" Style="{StaticResource DarkTextBox}"/>
                        <Button Grid.Column="1" Content="Browse..." Style="{StaticResource DarkButton}" Margin="8,0,0,0" Click="BrowseManualExe_Click"/>
                    </Grid>

                    <TextBlock Text="Steam App ID (Optional, for ACF creation):" Foreground="#8888A8" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="ManualAppIdBox" Style="{StaticResource DarkTextBox}" Margin="0,0,0,8"/>
                    <TextBlock Text="Example: 570 for Dota 2, 2357570 for Overwatch" Foreground="#55556A" FontSize="11"/>
                </StackPanel>
            </Grid>

            <!-- Footer Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancel" Style="{StaticResource DarkButton}" Width="90" Margin="0,0,10,0" Click="Cancel_Click"/>
                <Button x:Name="AddGameConfirmBtn" Content="Add to Games List" Style="{StaticResource AccentButton}" Padding="18,0" Click="AddConfirm_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>